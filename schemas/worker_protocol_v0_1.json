{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "parlawl worker protocol v0.1",
  "type": "object",
  "required": [
    "protocol_version",
    "request_type",
    "requested_at_utc",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "0.1"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "analyze_latest_solved_puzzle",
        "batch_sync_rerun"
      ]
    },
    "database_path": {
      "type": "string"
    },
    "requested_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
